  "cards": [
    {
      "dot": "cyan",
      "title": "Barrier semantics",
      "items": [
        "begin is open-or-join: one token per (target, step)",
        "Quorum policy: all ranks or a fraction",
        "Deadline abort is applied lazily on every access"
      ]
    },
    {
      "dot": "emerald",
      "title": "Integrity chain",
      "items": [
        "Client hash \u27f7 server hash on every chunk upload",
        "Commit re-verifies existence, size, and SHA-256 in storage",
        "Verification failure auto-aborts the barrier with a reason"
      ]
    },
    {
      "dot": "amber",
      "title": "Atomicity",
      "items": [
        "The manifest PUT is the only visibility flip",
        "latest.json is a lossy pointer; scan of manifests/ is the authority",
        "Re-commit after success is idempotent"
      ]
    }
  ]
