  "cards": [
    {
      "dot": "emerald",
      "title": "Hot path",
      "items": [
        "Contiguous lease ranges keep reads sequential",
        "Cache hits are pointer clones, never memcpy",
        "16 concurrent misses on one key = 1 backend GET"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lease control",
      "items": [
        "Coordinator grants half-open shard ranges with a TTL",
        "Expired leases return shards to the epoch pool",
        "renewed=false fences a worker off reassigned shards"
      ]
    },
    {
      "dot": "amber",
      "title": "Prefetch",
      "items": [
        "SDK hints upcoming keys on every read",
        "IO engine warms up to prefetch_depth objects",
        "Epoch starts avoid a thundering herd via single-flight"
      ]
    }
  ]
