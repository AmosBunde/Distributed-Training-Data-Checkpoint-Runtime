# SDK + examples image: run training examples and load tests against a
# runtime server without installing anything locally.
#
#   docker build -f docker/Dockerfile.python -t dtr-python:dev .

FROM python:3.12-slim-bookworm

RUN useradd --system --uid 10001 --home /app dtr
WORKDIR /app

COPY python /app/python
COPY examples /app/examples
COPY scripts /app/scripts

RUN pip install --no-cache-dir -e /app/python

USER dtr
ENV DTR_ENDPOINT=runtime:50051

ENTRYPOINT ["python"]
CMD ["-c", "import dtr; print(f'dtr {dtr.__version__} ready; run examples/ or scripts/load_test.py')"]
